# With nothing set, Type runs in preview mode: everything stays in this browser.

# Supabase (see supabase/README.md). The anon key is public by design; never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only if the apps move to subdomains of one domain you own (such as .elum.services); not possible on netlify.app.
VITE_ELUM_COOKIE_DOMAIN=
# ELUM Account. With it set, Type signs people in through Accounts (one sign-in for every app; see
# ELUMAccountsV1 docs/SIGN-IN.md). Unset, Type keeps its own sign-in page.
VITE_ELUM_ACCOUNT_URL=https://accountsbyelum.netlify.app
# Where the apps live. Defaults: https://writebyelum.netlify.app and https://typebyelum.netlify.app
VITE_ELUM_WRITE_URL=
VITE_ELUM_TYPE_URL=
# The domain Type addresses live on; must match elum.config type_domain. Defaults to type.elum.services
VITE_ELUM_TYPE_DOMAIN=
