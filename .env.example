# With nothing set, Type runs in preview mode: everything stays in this browser.

# Supabase (see supabase/README.md). The anon key is public by design; never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The parent domain every ELUM service shares (such as .elum.example). One sign-in then covers Write, Type and the rest.
VITE_ELUM_COOKIE_DOMAIN=
# Where Write lives, for "Open in Write" and the app switcher. Defaults to https://write.elum.example
VITE_ELUM_WRITE_URL=
# The domain Type addresses live on; must match elum.config type_domain. Defaults to type.elum.example
VITE_ELUM_TYPE_DOMAIN=
